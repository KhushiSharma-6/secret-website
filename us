  min-height: 90px;
}

.reason-controls {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 25px;
}

.little-note {
  font-size: 12px;
  color: #bc8a9c;
  margin-top: 25px;
}

/* GALLERY */

.gallery-section {
  background: white;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 25px;
  max-width: 950px;
  margin: auto;
}

.photo-card {
  background: white;
  padding: 12px 12px 25px;
  border-radius: 10px;
  box-shadow: 0 5px 20px #a56d801c;
  transform: rotate(-2deg);
  transition: .3s;
}

.photo-card:nth-child(even) {
  transform: rotate(2deg);
}

.photo-card:hover {
  transform: rotate(0) translateY(-8px);
}

.photo-card img {
  width: 100%;
  height: 230px;
  object-fit: cover;
  border-radius: 5px;
  cursor: zoom-in;
  background: #ffe6ef;
}

.photo-card p {
  font-family: 'Dancing Script', cursive;
  text-align: center;
  color: #ce7194;
  font-size: 23px;
  margin-top: 12px;
}

.gallery-note {
  text-align: center;
  margin-top: 30px;
  color: var(--muted);
  font-size: 13px;
}

/* LIGHTBOX */

.lightbox {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 500;
  background: #381c2bdd;
  align-items: center;
  justify-content: center;
  padding: 30px;
}

.lightbox.active {
  display: flex;
}

.lightbox img {
  max-width: 90%;
  max-height: 85vh;
  border: 10px solid white;
  border-radius: 8px;
  object-fit: contain;
}

#closeLightbox {
  position: absolute;
  top: 20px;
  right: 30px;
  border: none;
  background: none;
  color: white;
  font-size: 45px;
}

/* QUIZ */

.quiz-section {
  background: #fff4f8;
}

.quiz-card {
  max-width: 620px;
  margin: auto;
  background: white;
  padding: 35px;
  border-radius: 25px;
  text-align: center;
  box-shadow: 0 10px 35px #d987a51c;
}

.question-number {
  font-size: 12px;
  color: #bd8a9c;
  letter-spacing: 2px;
  margin-bottom: 15px;
}

.quiz-question {
  font-family: 'Playfair Display', serif;
  font-size: 22px;
  margin-bottom: 25px;
}

.quiz-options {
  display: grid;
  gap: 12px;
}

.quiz-option {
  background: #fff8fb;
  color: var(--text);
  border: 1px solid #f2c6d6;
  border-radius: 15px;
  padding: 15px;
  text-align: left;
  transition: .2s;
}

.quiz-option:hover:not(:disabled) {
  background: #ffe5ef;
  border-color: var(--dark-pink);
}

.quiz-option:disabled {
  cursor: default;
  opacity: .85;
}

.quiz-feedback {
  min-height: 25px;
  margin-top: 18px;
  color: var(--dark-pink);
  font-size: 13px;
}

.quiz-result {
  font-size: 17px;
  line-height: 1.9;
  margin-bottom: 20px;
}

.quiz-result h3 {
  font-family: 'Dancing Script', cursive;
  font-size: 38px;
  color: var(--dark-pink);
}

/* SECRET */

.secret-section {
  background: white;
}

.secret-box {
  max-width: 650px;
  margin: auto;
  background: #fff4f8;
  border-radius: 25px;
  padding: 40px 25px;
  text-align: center;
}

.secret-icon {
  font-size: 50px;
  margin-bottom: 15px;
}

.secret-box h3 {
  font-family: 'Dancing Script', cursive;
  font-size: 39px;
  color: var(--dark-pink);
  margin-bottom: 15px;
}

.secret-box > p {
  color: var(--muted);
  line-height: 1.8;
  margin-bottom: 20px;
}

.secret-message {
  margin-top: 25px;
  padding: 25px;
  background: white;
  border-radius: 18px;
  animation: appear .5s ease;
}

.secret-message p {
  line-height: 1.9;
  margin-bottom: 12px;
}

@keyframes appear {
  from {
    opacity: 0;
    transform: translateY(15px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* SURPRISE */

.surprise-section {
  background: linear-gradient(135deg, #ffe6ef, #fff8fb);
  text-align: center;
}

.surprise-message {
  font-family: 'Dancing Script', cursive;
