/* MUSIC PLAYER */

.music-player {
  position: fixed;
  bottom: 20px;
  right: 20px;
  z-index: 200;
  background: white;
  border: 1px solid #f3c9d8;
  box-shadow: 0 5px 25px #d987a533;
  border-radius: 40px;
  padding: 10px 17px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.music-player button {
  border: none;
  background: #ffe6ef;
  color: var(--dark-pink);
  width: 38px;
  height: 38px;
  border-radius: 50%;
  font-size: 16px;
}

.music-info {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.music-info span {
  font-size: 12px;
  font-weight: 700;
}

.music-info small {
  font-size: 10px;
  color: #b38a9a;
}

/* HEART ANIMATION */

.heart {
  position: fixed;
  bottom: -35px;
  z-index: 300;
  pointer-events: none;
  animation: heartFloat 5s linear forwards;
}

@keyframes heartFloat {
  0% {
    transform: translateY(0) rotate(0);
    opacity: 1;
  }
  100% {
    transform: translateY(-110vh) rotate(35deg);
    opacity: 0;
  }
}

